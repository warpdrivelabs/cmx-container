{
  "_comment": "跨引擎 parity 固定夹具：一张 4 层凭证（cv_batch→cv_header→cv_acc_line→cv_aux_line）。前端 JS CmxMasterSlave 与后端 Rust CmxMasterSlave 吃同一份，各自逐层上卷 6 个度量（entered/local/group 的 dr/cr），产出应逐字一致（除 id/upper_id/line_no/审计列）。度量只填在最底层 aux_line，上卷后 acc_line/header/batch 的度量应等于其子树之和。",
  "aggregations": [
    { "from": "cv_batch.cv_header.cv_acc_line.cv_aux_line", "to": "cv_batch.cv_header.cv_acc_line", "field": "entered_dr", "toField": "entered_dr", "agg": "sum" },
    { "from": "cv_batch.cv_header.cv_acc_line.cv_aux_line", "to": "cv_batch.cv_header.cv_acc_line", "field": "entered_cr", "toField": "entered_cr", "agg": "sum" },
    { "from": "cv_batch.cv_header.cv_acc_line.cv_aux_line", "to": "cv_batch.cv_header.cv_acc_line", "field": "local_dr", "toField": "local_dr", "agg": "sum" },
    { "from": "cv_batch.cv_header.cv_acc_line.cv_aux_line", "to": "cv_batch.cv_header.cv_acc_line", "field": "local_cr", "toField": "local_cr", "agg": "sum" },
    { "from": "cv_batch.cv_header.cv_acc_line", "to": "cv_batch.cv_header", "field": "entered_dr", "toField": "entered_dr", "agg": "sum" },
    { "from": "cv_batch.cv_header.cv_acc_line", "to": "cv_batch.cv_header", "field": "entered_cr", "toField": "entered_cr", "agg": "sum" },
    { "from": "cv_batch.cv_header.cv_acc_line", "to": "cv_batch.cv_header", "field": "local_dr", "toField": "local_dr", "agg": "sum" },
    { "from": "cv_batch.cv_header.cv_acc_line", "to": "cv_batch.cv_header", "field": "local_cr", "toField": "local_cr", "agg": "sum" },
    { "from": "cv_batch.cv_header", "to": "cv_batch", "field": "entered_dr", "toField": "entered_dr", "agg": "sum" },
    { "from": "cv_batch.cv_header", "to": "cv_batch", "field": "entered_cr", "toField": "entered_cr", "agg": "sum" },
    { "from": "cv_batch.cv_header", "to": "cv_batch", "field": "local_dr", "toField": "local_dr", "agg": "sum" },
    { "from": "cv_batch.cv_header", "to": "cv_batch", "field": "local_cr", "toField": "local_cr", "agg": "sum" }
  ],
  "flat": {
    "cv_batch": [
      { "id": "b1", "batch_name": "PARITY测试批", "doc_no": "PARITY-0001", "doc_date": "2026-08-03", "doc_type_id": 1, "entity_id": 1, "doc_status": 0 }
    ],
    "cv_header": [
      { "id": "h1", "upper_id": "b1", "doc_no": "PARITY-0001", "header_text": "跨引擎parity凭证", "reference": "REF-PARITY", "doc_date": "2026-08-03", "doc_type_id": 1, "entity_id": 1, "doc_status": 0 }
    ],
    "cv_acc_line": [
      { "id": "a1", "upper_id": "h1", "gl_account_id": 1001, "item_text": "科目行1", "posting_key_code": "40" },
      { "id": "a2", "upper_id": "h1", "gl_account_id": 1122, "item_text": "科目行2", "posting_key_code": "50" }
    ],
    "cv_aux_line": [
      { "id": "x1", "upper_id": "a1", "item_text": "辅助1", "entered_dr": 100, "entered_cr": 0, "local_dr": 100, "local_cr": 0 },
