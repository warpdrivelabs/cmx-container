[package]
name = "{{project_name}}"
version = "0.1.0"
edition = "2021"

[lib]
crate-type = ["cdylib"]

[dependencies]
# ============================================
# Extism PDK
# ============================================
extism-pdk = "1.4.1"

# ============================================
# CMX 插件 SDK
# ============================================
#cmx-plugin-sdk = { path = "../cmx-plugin-sdk" }
cmx-plugin-sdk = { version = "0.1.1", registry = "cmx-registry" }

# ============================================
# 序列化
# ============================================
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

[profile.release]
lto = true
opt-level = "s"

[profile.dev]
debug = 2
opt-level = 0