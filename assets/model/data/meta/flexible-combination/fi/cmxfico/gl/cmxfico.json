  "rules": [
    {
      "id": "r-l1-asset",
      "caption": "L1 资产类（$under=1）",
      "anchor": {
        "dimensions": [
          "gl_account"
        ],
        "columns": [
          "gl_account_id"
        ],
        "match": {
          "gl_account": {
            "$under": "1"
          }
        }
      },
      "panel": "cv_aux_line",
      "detail": {
        "table": "cv_aux_line",
        "pick": [
          {
            "ref": "cv_aux_line.cost_center_id",
            "over": {
              "caption": {
                "zh_CN": "成本中心"
              },
              "edit": {
                "mode": "cmx-dict-select"
              }
            }
          }
        ],
        "groups": [
          {
            "caption": "辅助核算(L1资产)",
            "members": [
              "cost_center_id"
            ]
          }
        ],
        "fieldTabs": [
          {
            "id": "ftab_amount",
            "table": "cv_acc_line",
            "pick": [
              {
                "ref": "cv_acc_line.item_text",
                "over": {
                  "caption": {
                    "zh_CN": "摘要"
                  }
                }
              },
              {
                "ref": "cv_acc_line.entered_dr",
                "over": {
                  "caption": {
                    "zh_CN": "金额"
                  },
                  "display": {
                    "decimalDigits": 2,
                    "thousandSeparator": true
                  }
                }
              }
            ],
            "groups": [
              {
                "caption": "金额信息(L1基础)",
