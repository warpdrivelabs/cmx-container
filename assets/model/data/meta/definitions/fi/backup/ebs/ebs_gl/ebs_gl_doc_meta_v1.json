{
  "moduleMeta": {
    "moduleCode": "ebs_gl",
    "moduleName": "总账(Oracle EBS)",
    "metaName": "Oracle EBS GL 会计凭证单据元数据",
    "metaKind": "DOC",
    "version": 1,
    "designStyle": "separate-dictionary-tables",
    "remark": "Oracle EBS GL 会计凭证三层单据结构:L1 凭证批 GL_JE_BATCHES → L2 凭证头 GL_JE_HEADERS → L3 凭证行 GL_JE_LINES(batch→header→line 一对多)。字段含 physicalField(EBS 真实列名 LEDGER_ID/CODE_COMBINATION_ID/ACCOUNTED_DR…)便于集成。核心维度为代码组合 CCID(弹性域各段在 GL_CODE_COMBINATIONS,非凭证行物理列,段数由 Accounting Flexfield 配置)。凭证多来自 Journal Import / 子分类账 Subledger Accounting(SLA:XLA_AE_HEADERS/LINES、GL_IMPORT_REFERENCES),行上 GL_SL_LINK_ID/TABLE 为关联键。批/头借贷合计(running_total)为 Oracle 系统维护字段。STATUS 为单字符码(U/P/I/E/S),批动作历史记于 GL_JE_ACTION_LOG。含审批-过账(处理中/错误)-冲销状态机与借贷平衡校验。通用单据列引用 base_doc_meta_v1.json。",
    "organizationDict": "ledger",
    "keyDicts": "code_combination",
    "documentTypeDict": "journal_category"
  },
  "baseDocMetaRef": {
    "file": "base_doc_meta_v1.json",
    "version": 1,
    "fieldSets": [
      "documentIdentityFields",
      "documentSourceFields",
      "documentLifecycleFields",
      "documentTechnicalFields",
      "documentCommonFields"
    ],
    "remark": "复用 base_doc_meta_v1.json 通用单据 fieldSet;voucherTables.documentFieldSets 引用该文件。"
  },
  "voucherCommonFieldSet": "documentTechnicalFields",
  "voucherDocumentMapping": {
    "remark": "EBS 凭证对通用单据字段的语义映射:document_* 显示为凭证日期/凭证类别/凭证号/过账状态。",
    "fieldAliases": {
      "document_date": "accounting_date",
      "document_type_id": "journal_category_id",
      "document_no": "document_no_seq",
      "document_status": "posting_status"
    },
    "typeDict": "journal_category",
    "stateField": "document_status"
  },
  "voucherSchema": {
    "remark": "EBS 凭证三层：L1 [ebs_gl_je_batch] → L2 [ebs_gl_je_header] → L3 [ebs_gl_je_line]。行借贷上卷到头借贷合计,头再汇总到批;凭证需借贷平衡。",
    "schema": [
      [
        {
          "id": "ebs_gl_je_batch",
          "kind": "list",
          "level": "L1",
          "levelName": "凭证批"
        }
      ],
      [
        {
          "id": "ebs_gl_je_header",
          "kind": "list",
          "level": "L2",
          "levelName": "凭证头"
        }
      ],
      [
        {
          "id": "ebs_gl_je_line",
          "kind": "list",
          "level": "L3",
          "levelName": "凭证行"
        }
      ]
    ],
    "relations": [
      {
        "parent": "ebs_gl_je_batch",
        "child": "headers",
        "parentKey": "id",
        "childKey": "batch_id"
      },
      {
        "parent": "headers",
        "child": "lines",
        "parentKey": "id",
        "childKey": "header_id"
      }
    ],
    "aggregations": [
      {
        "from": "ebs_gl_je_batch.headers.lines",
        "to": "ebs_gl_je_batch.headers",
        "field": "accounted_dr",
        "toField": "running_total_accounted_dr",
        "agg": "sum",
        "remark": "行本币借方(ACCOUNTED_DR)上卷到凭证头借方合计"
      },
      {
        "from": "ebs_gl_je_batch.headers.lines",
        "to": "ebs_gl_je_batch.headers",
        "field": "accounted_cr",
        "toField": "running_total_accounted_cr",
        "agg": "sum",
        "remark": "行本币贷方(ACCOUNTED_CR)上卷到凭证头贷方合计"
      },
      {
        "from": "ebs_gl_je_batch.headers",
        "to": "ebs_gl_je_batch",
        "field": "running_total_accounted_dr",
        "toField": "running_total_dr",
        "agg": "sum",
        "remark": "凭证头借方合计上卷到批"
      },
      {
        "from": "ebs_gl_je_batch.headers",
        "to": "ebs_gl_je_batch",
        "field": "running_total_accounted_cr",
        "toField": "running_total_cr",
        "agg": "sum",
        "remark": "凭证头贷方合计上卷到批"
      }
    ]
  },
