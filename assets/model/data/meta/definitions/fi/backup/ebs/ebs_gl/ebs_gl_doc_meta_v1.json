  "voucherStatusFlow": {
    "stateField": "document_status",
    "physicalField": "STATUS",
    "remark": "EBS 凭证生命周期：未过账(U)→已过账(P)，过账中可能处于处理中(I)或错误(E)。真实 GL_JE_BATCHES/GL_JE_HEADERS.STATUS 为单字符码(U未过账/P已过账/I处理中/E错误/S选中)，非单纯业务态；Posting Program 校验借贷平衡与期间开放；批动作历史另记于 GL_JE_ACTION_LOG。",
    "states": [
      {
        "code": "unposted",
        "name": "未过账",
        "editable": true,
        "physical": "STATUS=U",
        "remark": "Unposted,可改;需经审批(若启用)"
      },
      {
        "code": "approved",
        "name": "已审批",
        "editable": false,
        "remark": "审批通过,等待过账"
      },
      {
        "code": "processing",
        "name": "过账中",
        "editable": false,
        "physical": "STATUS=I",
        "remark": "Posting Program 处理中"
      },
      {
        "code": "error",
        "name": "过账错误",
        "editable": true,
        "physical": "STATUS=E",
        "remark": "过账失败(不平衡/期间关闭/CCID无效等),可改后重过"
      },
      {
        "code": "posted",
        "name": "已过账",
        "editable": false,
        "physical": "STATUS=P",
        "remark": "Posted,更新余额 GL_BALANCES"
      },
      {
        "code": "reversed",
        "name": "已冲销",
        "editable": false,
        "remark": "生成冲销凭证,终态"
      }
    ],
    "transitions": [
      {
        "action": "approve",
        "name": "审批",
        "from": "unposted",
        "to": "approved",
        "guard": [
          "balance_check"
        ]
      },
      {
        "action": "post",
        "name": "过账",
        "from": "approved",
        "to": "processing",
        "guard": [
          "balance_check",
          "period_open_check"
        ]
      },
      {
        "action": "post_done",
        "name": "过账完成",
        "from": "processing",
        "to": "posted",
        "guard": []
      },
      {
        "action": "post_fail",
        "name": "过账失败",
        "from": "processing",
        "to": "error",
        "guard": []
      },
      {
        "action": "fix_repost",
        "name": "纠错重过",
        "from": "error",
        "to": "processing",
        "guard": [
          "balance_check",
          "period_open_check"
        ]
      },
      {
        "action": "reverse",
        "name": "冲销",
        "from": "posted",
        "to": "reversed",
        "guard": [
          "period_open_check"
        ]
      }
    ]
  },
  "validationRules": [
    {
      "code": "journal_balance",
      "level": "error",
      "expr": "running_total_accounted_dr == running_total_accounted_cr",
      "message": "凭证必须借贷平衡(本币借方合计=贷方合计);非平衡账本除外"
    },
    {
      "code": "batch_control_total",
      "level": "warning",
      "expr": "control_total == 0 || control_total == running_total_dr",
      "message": "若填写控制总额,需与批实际借方合计一致"
    },
    {
      "code": "period_open",
      "level": "error",
      "expr": "period_status == 'O' || period_status == 'F'",
      "message": "会计期间必须为开放(O)或未来可输入(F)状态"
    },
    {
      "code": "ccid_postable",
      "level": "error",
      "expr": "allow_posting == 1",
      "message": "代码组合(CCID)必须启用且允许过账(非汇总值)"
    }
  ],
  "updatedAt": "2026-06-16T00:00:00.000Z"
}
