# cmx-container CI 门禁（GitLab CI）
#
# 目标：把此前靠人工纪律兜底的质量项固化为「每次推送/MR 必跑」的机器门禁，
# 避免每轮冲刺后都要重做一次质量收尾（见评估报告 v2→v3 的分数回落）。
#
# 阶段：secrets（密钥泄露扫描）→ check（编译）→ lint（fmt+clippy）→ test（单测）。
# 工具链由 rust-toolchain.toml 锁定（1.97.1）；镜像 tag 应与之保持一致。

stages:
  - secrets
  - check
  - lint
  - test

variables:
  # 增量编译在 CI 无收益且占缓存；关掉。
  CARGO_INCREMENTAL: "0"
  CARGO_TERM_COLOR: "always"
  # 用项目内缓存目录，配合下方 cache 规则复用 registry 与 target。
  CARGO_HOME: "$CI_PROJECT_DIR/.cargo"

# 复用 cargo registry 与编译产物，缩短流水线时长。
cache:
  key:
    files:
      - Cargo.lock
  paths:
    - .cargo/registry/index/
    - .cargo/registry/cache/
    - target/

default:
  image: rust:1.97.1
  before_script:
    - rustc --version && cargo --version

# ── 密钥泄露扫描（最先跑，最便宜，专治 .env 类事故复发）────────────────
# 硬失败：一旦扫到 .env 被追踪或源码里出现疑似凭据，阻断合并。
secret-scan:
  stage: secrets
  image: zricethezav/gitleaks:latest
  before_script: []
  script:
    # --no-git 扫工作树全文件；--redact 不回显命中的明文。
    - gitleaks detect --source . --no-git --redact --verbose
    # 额外硬检查：.env 绝不允许进入被追踪集。
    - |
      if git ls-files --error-unmatch .env 2>/dev/null; then
        echo "错误：.env 被 git 追踪，含密钥文件不得入库"; exit 1;
      fi
  allow_failure: false

# ── 编译门禁：整个 workspace 必须编过 ─────────────────────────────────
check:
  stage: check
  script:
    - cargo check --workspace --all-targets
  allow_failure: false

# ── 格式化门禁 ────────────────────────────────────────────────────────
# 全量 rustfmt 化已完成（cargo fmt --all，186 文件），转硬失败：
# 此后任何未格式化代码阻断合并。
fmt:
  stage: lint
  script:
    - cargo fmt --all -- --check
  allow_failure: false

# ── clippy 门禁 ───────────────────────────────────────────────────────
# 存量告警已清零（44→0：clippy --fix 自动修 37，手工修/放行 7）；转硬失败 -D warnings。
clippy:
  stage: lint
  script:
    - cargo clippy --workspace --all-targets -- -D warnings
  allow_failure: false

# ── 单元测试门禁 ──────────────────────────────────────────────────────
# 注：需要 live PG 的集成测试（cmx-biz form/menu、各 *_pg_test）在 CI 无库环境会失败，
# 故这里跑 --lib（纯单测）为主门禁；有库的 runner 可另设 job 跑全量。
test:
  stage: test
  script:
    - cargo test --workspace --lib
  allow_failure: false

# ── 集成测试门禁（PG service）─────────────────────────────────────────
# cmx-flow 的 9 个 *_pg.rs 是自建 schema（store.ensure_schema()）、只需一个空库，
# 不依赖 fico 种子数据，适合在 CI 起 postgres service 后跑。以 TEST_PG_URL 注入连接。
# 依赖 fico 种子的集成测试（doc 版本、DCT 落库）仍需有数据的 runner，暂不纳入。
# 现阶段 allow_failure（runner/service 首次接线需观察）；稳定后转硬失败。
integration-test:
  stage: test
  services:
    - name: postgres:16
      alias: postgres
  variables:
    POSTGRES_DB: cmx_ci
    POSTGRES_USER: postgres
    POSTGRES_PASSWORD: postgres
    TEST_PG_URL: "postgres://postgres:postgres@postgres:5432/cmx_ci"
  script:
    # 仅跑自建 schema、无需种子的 cmx-flow PG 集成测试（#[ignore] 门控，用 --ignored 显式开启）。
    - cargo test -p cmx-flow-tests -- --ignored --test-threads=1
  allow_failure: true
