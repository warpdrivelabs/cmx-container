
WEB_FOLDER="./crates/web/web-folder"
# 测试数据库连接串（替换为你的实际测试库；勿提交真实凭据）
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
#指定配置文件
CONFIG_FILE="./dev-local.toml"
#CONFIG_FILE="./dev-vpn.toml"
#panic 时打印详细调用栈
RUST_BACKTRACE=1
#日志级别
RUST_LOG=info,cranelift_codegen=info,wasmtime_internal_cranelift=info,h2=info,tower=info,nacos_sdk=info
# 设置特定模块的日志级别
#RUST_LOG=my_crate=debug,my_crate::module=trace
#解决构建时Swagger UI无法下载的问题
#SWAGGER_UI_DOWNLOAD_URL="file://$(pwd)/docker/res/swagger-ui-5.17.14.zip"
#EXTISM_DEBUG=1
#EXTISM_DEBUG_INFO=1
#启用Wasmtime缓存
#EXTISM_CACHE_CONFIG="wasmtime_config.toml"

# ========== 注册中心/配置中心（新前缀解耦配置，默认禁用；Nacos 连接参数沿用 NACOS_*） ==========
# 注册中心类型：mock（无网络行为）/ nacos。预置 nacos——翻 ENABLED 开关即启用，与旧 NACOS_ENABLED 行为一致。
SERVICE_REGISTRY_TYPE=nacos
# 是否启用服务注册（true/false）
SERVICE_REGISTRY_ENABLED=false
# 注册到注册中心的服务名称
SERVICE_REGISTRY_NAME=cmx-server-local
# 注册到注册中心的分组名称
SERVICE_REGISTRY_GROUP=DEFAULT_GROUP
# 是否启用配置中心（true/false）
CONFIG_CENTER_ENABLED=false
# 配置中心类型：mock / nacos（启用配置中心时需为 nacos）
CONFIG_CENTER_TYPE=nacos
# —— Nacos 连接配置（SERVICE_REGISTRY_TYPE=nacos 或 CONFIG_CENTER_TYPE=nacos 时生效）——
# Nacos 服务器地址（格式：host:port）
NACOS_SERVER_ADDR=<nacos-host>:8848
# 命名空间 ID（留空表示 public namespace）
NACOS_NAMESPACE=<namespace>
# 应用名称（用于服务注册）
NACOS_APP_NAME=cmx-container
# Nacos 认证用户名（可选；勿提交真实凭据）
NACOS_USERNAME=<nacos-user>
# Nacos 认证密码（可选；勿提交真实凭据）
NACOS_PASSWORD=<nacos-password>
# 配置中心的 Data ID
NACOS_CONFIG_DATA_ID=dev_config.toml
# 配置中心的 Group
NACOS_CONFIG_GROUP=DEFAULT_GROUP
# ========== 服务注册地址覆盖（可选，优先级高于 server.ip / server.port） ==========
# 注册使用的 IP（留空则回退到 server.ip，再回退到自动获取本机 IP）
#SERVICE_REGISTRY_IP=192.168.1.100
# 注册使用的端口（未设置或非法值则回退到 server.port，再回退到 8080）
#SERVICE_REGISTRY_PORT=8080

