# ============================================
# CMX Container 环境变量参考模板
# ============================================
# 复制此文件为 .env 使用：cp .env.template .env
# 所有变量通过环境变量注入，不在 TOML 文件中配置
# 这是出于安全考虑，防止远程配置覆盖敏感连接信息
#
# TOML 配置项详见 config_template.toml
# 环境变量详细说明详见 ENV_MANUAL.md

# ============================================
# 注册中心环境变量
# ============================================
# 注册中心类型：mock（默认）| nacos
SERVICE_REGISTRY_TYPE=mock
# 是否启用服务注册（true/false，默认 false）
SERVICE_REGISTRY_ENABLED=false
# 注册的服务名称（默认 cmx-server）
SERVICE_REGISTRY_NAME=cmx-server
# 分组名称（默认 DEFAULT_GROUP）
SERVICE_REGISTRY_GROUP=DEFAULT_GROUP
# 集群名称（默认 DEFAULT）
SERVICE_REGISTRY_CLUSTER=DEFAULT
# 实例权重（默认 1.0）
SERVICE_REGISTRY_WEIGHT=1.0
# 注册使用的 IP（优先级高于 NACOS_REGISTER_SERVER_IP，留空则自动检测）
SERVICE_REGISTRY_IP=
# 注册使用的端口（优先级高于 NACOS_REGISTER_SERVER_PORT，留空则使用 server.port，再缺省 8080）
# ★独立微服务（cmx-flow-server/cmx-rpt-server/cmx-rule-server 等）开启注册时**必填**：
#   服务 HTTP 端口来自各自前缀 env（FLOW_PORT 等）、不写 server.port，漏配会注册成 8080 错端口
SERVICE_REGISTRY_PORT=

# ============================================
# 配置中心环境变量
# ============================================
# 配置中心类型：mock（默认）| nacos
CONFIG_CENTER_TYPE=mock
# 是否启用配置中心（true/false，默认 false）
CONFIG_CENTER_ENABLED=false

# ============================================
# 部署模式
# ============================================
# mono（默认）：单体模式，一个进程服务所有域/应用/模块，app_id 固定 "default"
# micro       ：微服务模式，一个进程只服务 [app] 三元组指定的模块，app_id = [app].module_code
DEPLOY__MODE=mono

# ============================================
# 应用标识（仅 micro 模式生效）
# ============================================
# 应用隔离标识（默认 default）
# micro 模式下生效；mono 模式下固定为 default，此处配置被忽略
APP_ID=default

# ============================================
# Nacos 连接配置（SERVICE_REGISTRY_TYPE=nacos 或 CONFIG_CENTER_TYPE=nacos 时生效）
# ============================================
# Nacos 服务器地址（默认 127.0.0.1:8848）
NACOS_SERVER_ADDR=127.0.0.1:8848
# 命名空间（默认 ""）
NACOS_NAMESPACE=
# 应用名称（默认 cmx-container）
NACOS_APP_NAME=cmx-container
# 认证用户名（可选）
NACOS_USERNAME=
# 认证密码（可选）
NACOS_PASSWORD=
# 配置 Data ID
NACOS_CONFIG_DATA_ID=
# 配置 Group（默认 DEFAULT_GROUP）
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# ============================================
# 兼容旧 NACOS_* 环境变量（不推荐，建议迁移到新变量）
# ============================================
## 自动启用注册中心 + 配置中心，类型设为 nacos（不推荐，建议分别设置 SERVICE_REGISTRY_ENABLED 和 CONFIG_CENTER_ENABLED）
# NACOS_ENABLED=
## 映射为 SERVICE_REGISTRY_ENABLED（不推荐）
# NACOS_NAMING_ENABLED=
## 映射为 CONFIG_CENTER_ENABLED（不推荐）
# NACOS_CONFIG_ENABLED=
## 回退为 SERVICE_REGISTRY_NAME（不推荐）
# NACOS_NAMING_SERVICE_NAME=
## 回退为 SERVICE_REGISTRY_GROUP（不推荐）
# NACOS_NAMING_GROUP_NAME=
## 回退为 SERVICE_REGISTRY_IP（不推荐）
# NACOS_REGISTER_SERVER_IP=
## 回退为 SERVICE_REGISTRY_PORT（不推荐）
# NACOS_REGISTER_SERVER_PORT=

# ============================================
# OpenCode AI 中继配置（cmx-ai 薄代理，优先级高于 config.toml [opencode] 段）
# ============================================
# OpenCode 服务地址（含协议与端口，默认 http://127.0.0.1:4096）
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OpenCode 访问凭证（OPENCODE_SERVER_PASSWORD）；留空表示 OpenCode 未启用鉴权（仅开发环境）
# 生产部署必须配置强密码，cmx-ai 所有请求（含 SSE）会以 Authorization: Bearer 携带
# OPENCODE_SERVER_PASSWORD=

# ============================================
# 基础服务中心环境变量覆盖（center_client 配置节，v2 services 单表形态）
# ============================================
# 服务间调用全局传输缺省（http | grpc，默认 http；grpc 需启用 [rpc] 且对应键配 discovery）
# CENTER_CLIENT__DEFAULT_TRANSPORT=http
# Nacos 分组（discovery 定位的键共用，默认 DEFAULT_GROUP）
# CENTER_CLIENT__NACOS_GROUP=DEFAULT_GROUP
# 请求超时时间（毫秒，默认 30000）
# CENTER_CLIENT__TIMEOUT_MS=30000
# 服务键 → 服务描述（url 静态基址 / discovery 服务名 / transport 传输覆盖；url 值需带 scheme，
# 纯数字值会被环境变量层解析为整数导致反序列化失败）
# CENTER_CLIENT__SERVICES__MENU__URL=http://127.0.0.1:8080
# CENTER_CLIENT__SERVICES__MENU__DISCOVERY=cmx-portal-center
# CENTER_CLIENT__SERVICES__PERM__TRANSPORT=grpc
# CENTER_CLIENT__SERVICES__FLOW__URL=http://127.0.0.1:8091

# ============================================
# 服务对外身份环境变量覆盖（service_auth 配置节）
# ============================================
# 本服务作为调用方时携带的服务级凭证（cmx_sk_xxx），须同时在 [[auth.static_api_keys]] 注册
# 留空表示不配置服务身份（仅单体无跨服务调用场景）。生产环境优先用环境变量注入。
# SERVICE_AUTH__OUTGOING_API_KEY=

# ============================================
# 认证配置环境变量覆盖（auth 配置节）
# ============================================
# 环境变量使用双下划线 __ 分隔层级，对应 TOML 中的点分隔键
# 例如 AUTH__JWT__SECRET 对应 auth.jwt.secret

## JWT 签名算法（HS256 / RS256，默认 HS256）
# AUTH__JWT__ALGORITHM=HS256
# HMAC 密钥（HS256 模式，生产环境务必修改）
AUTH__JWT__SECRET=a7k9m2p4x8q1w5e3r6t0y7u2i9o4p1
## JWT 签发者（默认 cmx-auth）
# AUTH__JWT__ISSUER=cmx-auth
## JWT 受众（默认 cmx-platform）
# AUTH__JWT__AUDIENCE=cmx-platform
## RS256 私钥（文件路径或 PEM 内容，RS256 模式时必需）
# AUTH__JWT__PRIVATE_KEY=/path/to/private.pem
## RS256 公钥（文件路径或 PEM 内容，RS256 模式时必需）
# AUTH__JWT__PUBLIC_KEY=/path/to/public.pem
## 当前签发使用的密钥 ID（可选，用于密钥轮换标识）
# AUTH__JWT__CURRENT_KID=key-2026-01
## 旧密钥列表（密钥轮换宽限期，最多 5 个，可选）
# AUTH__JWT__LEGACY_PUBLIC_KEYS_0_KID=key-2025-12
# AUTH__JWT__LEGACY_PUBLIC_KEYS_0_PEM=/path/to/old-public.pem

# Argon2 密码哈希参数
## 内存开销 KB（默认 65536 = 64MB）
# AUTH__ARGON2__MEMORY_COST=65536
## 时间开销（默认 3）
# AUTH__ARGON2__TIME_COST=3
## 并行度（默认 4）
# AUTH__ARGON2__PARALLELISM=4

## Access Token 有效期秒（默认 1800）
# AUTH__TOKEN__ACCESS_TTL_SECS=1800
## Refresh Token 有效期秒（默认 604800）
# AUTH__TOKEN__REFRESH_TTL_SECS=604800

# 会话配置
## 同一设备类型是否仅允许一个会话（true/false，默认 false）
# AUTH__SESSION__SINGLE_SESSION_PER_DEVICE_TYPE=false
## 最大并发会话数（0 = 不限制，默认 0）
# AUTH__SESSION__MAX_SESSIONS=0
## 会话空闲超时秒（默认 86400）
# AUTH__SESSION__IDLE_TIMEOUT_SECS=86400
## 心跳间隔秒（默认 300）
# AUTH__SESSION__HEARTBEAT_INTERVAL_SECS=300

# 认证缓存配置
## 是否启用本地缓存（true/false，默认 true）
# AUTH__CACHE__ENABLE_LOCAL_CACHE=true
## 本地缓存 TTL 秒（默认 30）
# AUTH__CACHE__LOCAL_TTL_SECS=30
## 本地缓存最大容量（默认 10000）
# AUTH__CACHE__LOCAL_CACHE_MAX_ENTRIES=10000
## 登录失败锁定阈值（默认 5）
# AUTH__CACHE__MAX_LOGIN_ATTEMPTS=5
## 账号锁定时长秒（默认 900）
# AUTH__CACHE__LOCK_DURATION_SECS=900

# ============================================
# 超管初始化配置（可选）
# ============================================
## 超管用户名（必需，首次创建时使用）
# AUTH__SUPER_ADMIN__USERNAME=admin
## 超管初始密码（必需，生产环境务必通过环境变量注入）
# AUTH__SUPER_ADMIN__PASSWORD=a7k9m2p4x8q1w5e3r6t0y7u2i9o4p1
## 超管邮箱（可选）
# AUTH__SUPER_ADMIN__EMAIL=admin@example.com
## 超管角色编码（可选，逗号分隔，默认 admin）
# AUTH__SUPER_ADMIN__ROLES=admin

# ============================================
# OAuth2 配置环境变量覆盖（可选模块）
# ============================================
## 授权码有效期秒（默认 600）
# AUTH__OAUTH2__AUTH_CODE_TTL_SECS=600
## 是否强制 PKCE（默认 true，生产环境建议开启）
# AUTH__OAUTH2__PKCE_REQUIRED=true

# ============================================
# 通用环境变量
# ============================================
# 指定配置文件路径（如 /path/to/config.toml，留空使用默认路径）
# CONFIG_FILE=
