# ============================================
# CMX Container 环境变量参考模板
# ============================================
# 复制此文件为 .env 使用：cp .env.template .env
# 所有变量通过环境变量注入，不在 TOML 文件中配置
# 这是出于安全考虑，防止远程配置覆盖敏感连接信息
#
# TOML 配置项详见 config_template.toml
# 环境变量详细说明详见 ENV_MANUAL.md

# ============================================
# 注册中心环境变量
# ============================================
# 注册中心类型：mock（默认）| nacos
SERVICE_REGISTRY_TYPE=mock
# 是否启用服务注册（true/false，默认 false）
SERVICE_REGISTRY_ENABLED=false
# 注册的服务名称（默认 cmx-server）
SERVICE_REGISTRY_NAME=cmx-server
# 分组名称（默认 DEFAULT_GROUP）
SERVICE_REGISTRY_GROUP=DEFAULT_GROUP
# 集群名称（默认 DEFAULT）
SERVICE_REGISTRY_CLUSTER=DEFAULT
# 实例权重（默认 1.0）
SERVICE_REGISTRY_WEIGHT=1.0
# 注册使用的 IP（优先级高于 NACOS_REGISTER_SERVER_IP，留空则自动检测）
SERVICE_REGISTRY_IP=
# 注册使用的端口（优先级高于 NACOS_REGISTER_SERVER_PORT，留空则使用 server.port）
SERVICE_REGISTRY_PORT=

# ============================================
# 配置中心环境变量
# ============================================
# 配置中心类型：mock（默认）| nacos
CONFIG_CENTER_TYPE=mock
# 是否启用配置中心（true/false，默认 false）
CONFIG_CENTER_ENABLED=false

# ============================================
# 应用标识
# ============================================
# 应用隔离标识（默认 default）
APP_ID=default

# ============================================
# Nacos 连接配置（SERVICE_REGISTRY_TYPE=nacos 或 CONFIG_CENTER_TYPE=nacos 时生效）
# ============================================
# Nacos 服务器地址（默认 127.0.0.1:8848）
NACOS_SERVER_ADDR=127.0.0.1:8848
# 命名空间（默认 ""）
NACOS_NAMESPACE=
# 应用名称（默认 cmx-container）
NACOS_APP_NAME=cmx-container
# 认证用户名（可选）
NACOS_USERNAME=
# 认证密码（可选）
NACOS_PASSWORD=
# 配置 Data ID
NACOS_CONFIG_DATA_ID=
# 配置 Group（默认 DEFAULT_GROUP）
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# ============================================
# 兼容旧 NACOS_* 环境变量（不推荐，建议迁移到新变量）
# ============================================
# 自动启用注册中心 + 配置中心，类型设为 nacos（不推荐，建议分别设置 SERVICE_REGISTRY_ENABLED 和 CONFIG_CENTER_ENABLED）
# NACOS_ENABLED=
# 映射为 SERVICE_REGISTRY_ENABLED（不推荐）
# NACOS_NAMING_ENABLED=
# 映射为 CONFIG_CENTER_ENABLED（不推荐）
# NACOS_CONFIG_ENABLED=
# 回退为 SERVICE_REGISTRY_NAME（不推荐）
# NACOS_NAMING_SERVICE_NAME=
# 回退为 SERVICE_REGISTRY_GROUP（不推荐）
# NACOS_NAMING_GROUP_NAME=
# 回退为 SERVICE_REGISTRY_IP（不推荐）
# NACOS_REGISTER_SERVER_IP=
# 回退为 SERVICE_REGISTRY_PORT（不推荐）
# NACOS_REGISTER_SERVER_PORT=

# ============================================
# 基础服务中心环境变量覆盖（center_client 配置节）
# ============================================
# 访问模式（mock / url / discovery，默认 mock）
CENTER_CLIENT__MODE=mock
# 请求超时时间（毫秒，默认 30000）
CENTER_CLIENT__TIMEOUT_MS=30000
# 门户中心 URL
CENTER_CLIENT__URLS__MENU=
# 权限中心 URL
CENTER_CLIENT__URLS__PERM=
# 表单中心 URL
CENTER_CLIENT__URLS__FORM=
# 流程中心 URL
CENTER_CLIENT__URLS__FLOW=

# ============================================
# 通用环境变量
# ============================================
# 指定配置文件路径（如 /path/to/config.toml，留空使用默认路径）
# CONFIG_FILE=
