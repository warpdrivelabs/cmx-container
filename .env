
WEB_FOLDER="./crates/web/web-folder"
TEST_DATABASE_URL=postgresql://postgres:postgres@192.168.137.80:5432/postgres
#指定配置文件
CONFIG_FILE="./dev.toml"
#CONFIG_FILE="./dev-vpn.toml"
#panic 时打印详细调用栈
RUST_BACKTRACE=1
#日志级别
RUST_LOG=info,cranelift_codegen=info,wasmtime-internal-cranelift=info
# 设置特定模块的日志级别
#RUST_LOG=my_crate=debug,my_crate::module=trace
#解决构建时Swagger UI无法下载的问题
#SWAGGER_UI_DOWNLOAD_URL="file://$(pwd)/v5.17.14.zip"
EXTISM_DEBUG=1
EXTISM_DEBUG_INFO=1
#启用Wasmtime缓存
EXTISM_CACHE_CONFIG="wasmtime_config.toml"

# ========== Nacos 配置（默认禁用，启用时取消注释并修改） ==========
# 是否启用 Nacos（true/false）
#NACOS_ENABLED=true
# Nacos 服务器地址（格式：host:port）
#NACOS_SERVER_ADDR=127.0.0.1:8848
# 命名空间 ID（留空表示 public namespace）
#NACOS_NAMESPACE=
# 应用名称（用于服务注册）
#NACOS_APP_NAME=cmx-web
# Nacos 认证用户名（可选）
#NACOS_USERNAME=
# Nacos 认证密码（可选）
#NACOS_PASSWORD=
# 是否启用服务注册（true/false）
#NACOS_NAMING_ENABLED=true
# 注册到 Nacos 的服务名称
#NACOS_NAMING_SERVICE_NAME=cmx-web
# 注册到 Nacos 的分组名称
#NACOS_NAMING_GROUP_NAME=DEFAULT_GROUP
# 是否启用配置中心（true/false）
#NACOS_CONFIG_ENABLED=true
# 配置中心的 Data ID
#NACOS_CONFIG_DATA_ID=cmx-web.toml
# 配置中心的 Group
#NACOS_CONFIG_GROUP=DEFAULT_GROUP
