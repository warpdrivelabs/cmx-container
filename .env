
WEB_FOLDER="./crates/web/web-folder"
TEST_DATABASE_URL=postgresql://postgres:postgres@192.168.137.80:5432/postgres
#指定配置文件
CONFIG_FILE="./dev.toml"
#CONFIG_FILE="./dev-vpn.toml"
#panic 时打印详细调用栈
RUST_BACKTRACE=1
#日志级别
RUST_LOG=info,cranelift_codegen=info,wasmtime_internal_cranelift=info,h2=info,tower=info,nacos_sdk=info
# 设置特定模块的日志级别
#RUST_LOG=my_crate=debug,my_crate::module=trace
#解决构建时Swagger UI无法下载的问题
#SWAGGER_UI_DOWNLOAD_URL="file://$(pwd)/docker/res/swagger-ui-5.17.14.zip"
#EXTISM_DEBUG=1
#EXTISM_DEBUG_INFO=1
#启用Wasmtime缓存
#EXTISM_CACHE_CONFIG="wasmtime_config.toml"

# ========== Nacos 配置（默认禁用，启用时取消注释并修改） ==========
# 是否启用 Nacos（true/false）
NACOS_ENABLED=true
# Nacos 服务器地址（格式：host:port）
NACOS_SERVER_ADDR=192.168.1.14:8848
#NACOS_SERVER_ADDR=192.168.157.46:8848
# 命名空间 ID（留空表示 public namespace）
NACOS_NAMESPACE=
# 应用名称（用于服务注册）
NACOS_APP_NAME=cmx-container
# Nacos 认证用户名（可选）
NACOS_USERNAME=admin
# Nacos 认证密码（可选）
NACOS_PASSWORD=admin
# 是否启用服务注册（true/false）
NACOS_NAMING_ENABLED=true
# 注册到 Nacos 的服务名称
NACOS_NAMING_SERVICE_NAME=cmx-server
# 注册到 Nacos 的分组名称
NACOS_NAMING_GROUP_NAME=DEFAULT_GROUP
# 是否启用配置中心（true/false）
NACOS_CONFIG_ENABLED=false
# 配置中心的 Data ID
NACOS_CONFIG_DATA_ID=dev_config.toml
# 配置中心的 Group
NACOS_CONFIG_GROUP=DEFAULT_GROUP
# ========== 服务注册地址覆盖（可选，优先级高于 server.ip / server.port） ==========
# 注册到 Nacos 的 IP（留空则回退到 server.ip，再回退到自动获取本机 IP）
#NACOS_REGISTER_SERVER_IP=192.168.1.100
# 注册到 Nacos 的端口（未设置或非法值则回退到 server.port，再回退到 8080）
#NACOS_REGISTER_SERVER_PORT=8080
