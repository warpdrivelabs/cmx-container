{
  "docMeta": {
    "docCode": "sap_fi",
    "metaName": "SAP FI 会计凭证单据元数据",
    "metaKind": "DOC",
    "version": 1,
    "designStyle": "separate-dictionary-tables",
    "remark": "SAP ERP(ECC/S4) FI 会计凭证单据结构：L1 凭证头 BKPF → L2 行项目 BSEG。真实凭证主键为 BUKRS(公司代码)+BELNR(凭证号)+GJAHR(会计年度) 三段复合键，BELNR 由凭证类型的 FI number range 生成。S/4HANA 行项目对应 Universal Journal 通用日记账 ACDOCA(更宽、含并行分类账/多币种，非同一物理表)，本模型以经典 BSEG 建模并把分类账 RLDNR 下沉到行层。字段含 physicalField(SAP 真实技术字段名 BUKRS/HKONT/DMBTR…)便于集成对接；按 dimType 区分维度/属性/度量；借贷由金额+借贷标志 SHKZG 表达(不另存借贷分栏)；凭证头借贷合计为派生缓存(真实 BKPF 无此列)。含 held/parked/posted/reversed 状态机与借贷平衡校验。通用单据列引用 base_doc_meta_v1.json。",
    "organizationDict": "company_code",
    "keyDicts": "gl_account",
    "documentTypeDict": "document_type"
  },
  "baseDocMetaRef": {
    "file": "base_doc_meta_v1.json",
    "version": 1,
    "fieldSets": [
      "documentIdentityFields",
      "documentSourceFields",
      "documentLifecycleFields",
      "documentTechnicalFields",
      "documentCommonFields"
    ],
    "remark": "复用 base_doc_meta_v1.json 通用单据 fieldSet；voucherTables.documentFieldSets 引用该文件。"
  },
  "voucherCommonFieldSet": "documentTechnicalFields",
  "voucherDocumentMapping": {
    "remark": "SAP 凭证对通用单据字段的语义映射:界面显示时 document_* 映射为凭证日期/凭证类型/凭证号/凭证状态。",
    "fieldAliases": {
      "document_date": "posting_date",
      "document_type_id": "doc_type_id",
      "document_no": "voucher_no",
      "document_status": "voucher_status"
    },
    "typeDict": "document_type",
    "stateField": "document_status"
  },
  "voucherSchema": {
    "remark": "凭证主从两层：L1 [sap_fi_document_header] → L2 [sap_fi_document_item]。行项目金额(amount_local)按借贷标志(SHKZG)上卷至凭证头借贷合计；凭证需在公司代码内借贷平衡。",
    "schema": [
      [
        {
          "id": "sap_fi_document_header",
          "kind": "list",
          "level": "L1",
          "levelName": "凭证头"
        }
      ],
      [
        {
          "id": "sap_fi_document_item",
          "kind": "list",
          "level": "L2",
          "levelName": "行项目"
        }
      ]
    ],
    "relations": [
      {
        "parent": "sap_fi_document_header",
        "child": "items",
        "parentKey": "id",
        "childKey": "header_id"
      }
    ],
    "aggregations": [
      {
        "from": "sap_fi_document_header.items",
        "to": "sap_fi_document_header",
        "field": "amount_local",
        "toField": "total_debit",
        "agg": "sum",
        "where": "debit_credit=='S'",
        "remark": "借方(SHKZG=S)行金额上卷到凭证头借方合计"
      },
      {
        "from": "sap_fi_document_header.items",
        "to": "sap_fi_document_header",
        "field": "amount_local",
        "toField": "total_credit",
        "agg": "sum",
        "where": "debit_credit=='H'",
        "remark": "贷方(SHKZG=H)行金额上卷到凭证头贷方合计"
      }
    ]
  },
