  "voucherStatusFlow": {
    "stateField": "document_status",
    "physicalField": "BSTAT",
    "remark": "SAP 会计凭证生命周期：暂存(held)/预制(parked)→已过账(posted)→(冲销 reversed)。真实凭证记录状态在 BKPF.BSTAT(空=正常已过账, V=预制, S=统计, ...)；本状态机为业务语义抽象。posted 不可改,只能冲销。",
    "states": [
      {
        "code": "held",
        "name": "暂存",
        "editable": true,
        "remark": "Held Document,临时暂存,未编号未生成余额"
      },
      {
        "code": "parked",
        "name": "预制/草稿",
        "editable": true,
        "physical": "BSTAT=V",
        "remark": "Parked Document,可改可删,尚未生成余额"
      },
      {
        "code": "posted",
        "name": "已过账",
        "editable": false,
        "physical": "BSTAT=(空)",
        "remark": "Posted,记入总账生成余额,不可逆"
      },
      {
        "code": "reversed",
        "name": "已冲销",
        "editable": false,
        "remark": "通过红冲凭证冲销,终态"
      }
    ],
    "transitions": [
      {
        "action": "park",
        "name": "预制",
        "from": "held",
        "to": "parked",
        "guard": []
      },
      {
        "action": "post",
        "name": "过账",
        "from": "parked",
        "to": "posted",
        "guard": [
          "balance_check",
          "period_open_check"
        ]
      },
      {
        "action": "post_direct",
        "name": "直接过账",
        "from": "held",
        "to": "posted",
        "guard": [
          "balance_check",
          "period_open_check"
        ]
      },
      {
        "action": "reverse",
        "name": "冲销",
        "from": "posted",
        "to": "reversed",
        "guard": [
          "period_open_check"
        ]
      }
    ]
  },
  "validationRules": [
    {
      "code": "debit_credit_balance",
      "level": "error",
      "expr": "total_debit == total_credit",
      "message": "凭证必须在公司代码内借贷平衡(借方合计=贷方合计)"
    },
    {
      "code": "min_two_lines",
      "level": "error",
      "expr": "item_count >= 2",
      "message": "会计凭证至少需要两条行项目(一借一贷)"
    },
    {
      "code": "period_open",
      "level": "error",
      "expr": "posting_allowed == 1",
      "message": "记账期间必须处于开放状态(记账期间变式校验)"
    },
    {
      "code": "tax_code_required_on_tax_account",
      "level": "warning",
      "expr": "is_tax_relevant == 1 => tax_code != null",
      "message": "税务相关科目建议填写税码"
    }
  ],
  "updatedAt": "2026-06-16T00:00:00.000Z"
}
