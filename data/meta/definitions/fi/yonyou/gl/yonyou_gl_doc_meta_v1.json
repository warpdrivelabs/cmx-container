{
  "docMeta": {
    "metaCode": "GL",
    "metaName": "用友 ERP GL 会计凭证单据元数据",
    "metaKind": "DOC",
    "version": 1,
    "designStyle": "separate-dictionary-tables",
    "remark": "用友 ERP(NC/U8) 会计凭证三层单据结构:L1 凭证头 → L2 分录(借贷分录) → L3 分录辅助核算明细。字段含 physicalField(用友真实字段名 pk_accasoa/debitamount/creditamount…)便于集成。用友精髓:辅助核算为分录 1:N 子表(NC gl_freevalue/U8 辅助核算),一条分录按科目所挂辅助项动态挂任意多个 {辅助类型,取值},非固定列;借贷由借列/贷列定方向(direction 派生);凭证头借贷合计为派生缓存。含制单-审核-记账-冲销状态机与借贷平衡校验。通用单据列引用 base_doc_meta_v1.json。",
    "organizationDict": "accounting_org",
    "keyDicts": "account_subject",
    "documentTypeDict": "voucher_category"
  },
  "baseDocMetaRef": {
    "file": "base_doc_meta_v1.json",
    "version": 1,
    "fieldSets": [
      "documentIdentityFields",
      "documentSourceFields",
      "documentLifecycleFields",
      "documentTechnicalFields",
      "documentCommonFields"
    ],
    "remark": "复用 base_doc_meta_v1.json 通用单据 fieldSet;voucherTables.documentFieldSets 引用该文件。"
  },
  "voucherCommonFieldSet": "documentTechnicalFields",
  "voucherDocumentMapping": {
    "remark": "用友凭证对通用单据字段的语义映射:document_* 显示为制单日期/凭证类别/凭证字号/凭证状态。",
    "fieldAliases": {
      "document_date": "voucher_date",
      "document_type_id": "voucher_category_id",
      "document_no": "voucher_word_no",
      "document_status": "voucher_status"
    },
    "typeDict": "voucher_category",
    "stateField": "document_status"
  },
  "voucherSchema": {
    "remark": "用友凭证三层:L1 [yy_gl_voucher_header] → L2 [yy_gl_voucher_entry] → L3 [yy_gl_voucher_entry_aux 辅助核算明细]。分录借贷金额上卷至凭证头借贷合计;一条分录挂任意多个辅助核算项;凭证借贷必须平衡。",
    "schema": [
      [
        {
          "id": "yy_gl_voucher_header",
          "kind": "list",
          "level": "L1",
          "levelName": "凭证头"
        }
      ],
      [
        {
          "id": "yy_gl_voucher_entry",
          "kind": "list",
          "level": "L2",
          "levelName": "分录"
        }
      ],
      [
        {
          "id": "yy_gl_voucher_entry_aux",
          "kind": "list",
          "level": "L3",
          "levelName": "辅助核算明细"
        }
      ]
    ],
    "relations": [
      {
        "parent": "yy_gl_voucher_header",
        "child": "entries",
        "parentKey": "id",
        "childKey": "header_id"
      },
      {
        "parent": "entries",
        "child": "auxitems",
        "parentKey": "id",
        "childKey": "entry_id"
      }
    ],
    "aggregations": [
      {
        "from": "yy_gl_voucher_header.entries",
        "to": "yy_gl_voucher_header",
        "field": "debit_amount",
        "toField": "total_debit",
        "agg": "sum",
        "remark": "分录借方上卷到凭证头借方合计"
      },
      {
        "from": "yy_gl_voucher_header.entries",
        "to": "yy_gl_voucher_header",
        "field": "credit_amount",
        "toField": "total_credit",
        "agg": "sum",
        "remark": "分录贷方上卷到凭证头贷方合计"
      }
    ]
  },
