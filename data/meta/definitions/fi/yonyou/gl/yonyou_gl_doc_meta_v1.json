  "voucherStatusFlow": {
    "stateField": "document_status",
    "physicalField": "vbillstatus",
    "remark": "用友凭证生命周期:制单(草稿)→审核→记账→(出纳签字,收付款凭证)。已记账不可改,只能红字冲销。期末结账后该期凭证锁定。真实状态在 vbillstatus/标志位(tally记账标志、checkstyle审核)。",
    "states": [
      {
        "code": "draft",
        "name": "已制单",
        "editable": true,
        "remark": "草稿,可改可删"
      },
      {
        "code": "audited",
        "name": "已审核",
        "editable": false,
        "remark": "审核通过,锁定编辑"
      },
      {
        "code": "posted",
        "name": "已记账",
        "editable": false,
        "remark": "记账,更新科目余额,不可逆"
      },
      {
        "code": "reversed",
        "name": "已冲销",
        "editable": false,
        "remark": "红字冲销,终态"
      }
    ],
    "transitions": [
      {
        "action": "audit",
        "name": "审核",
        "from": "draft",
        "to": "audited",
        "guard": [
          "balance_check",
          "preparer_auditor_different"
        ]
      },
      {
        "action": "post",
        "name": "记账",
        "from": "audited",
        "to": "posted",
        "guard": [
          "balance_check",
          "period_open_check"
        ]
      },
      {
        "action": "reverse",
        "name": "红冲",
        "from": "posted",
        "to": "reversed",
        "guard": [
          "period_open_check"
        ]
      }
    ]
  },
  "validationRules": [
    {
      "code": "debit_credit_balance",
      "level": "error",
      "expr": "total_debit == total_credit",
      "message": "凭证必须借贷平衡(借方合计=贷方合计)"
    },
    {
      "code": "min_two_entries",
      "level": "error",
      "expr": "entry_count >= 2",
      "message": "凭证至少两条分录(一借一贷)"
    },
    {
      "code": "preparer_auditor_different",
      "level": "error",
      "expr": "preparer_id != auditor_id",
      "message": "制单人与审核人不能为同一人"
    },
    {
      "code": "aux_required_on_aux_account",
      "level": "error",
      "expr": "has_aux_accounting == 1 => aux_filled == 1",
      "message": "科目设置了辅助核算时,分录必须录入对应辅助核算项"
    },
    {
      "code": "cashflow_required_on_cash_account",
      "level": "warning",
      "expr": "is_cash_account == 1 => cashflow_item_id != null",
      "message": "现金类科目分录建议指定现金流量项目"
    },
    {
      "code": "period_not_closed",
      "level": "error",
      "expr": "closed_flag == 0",
      "message": "已结账的会计期间不允许制单/记账"
    }
  ],
  "updatedAt": "2026-06-16T00:00:00.000Z"
}