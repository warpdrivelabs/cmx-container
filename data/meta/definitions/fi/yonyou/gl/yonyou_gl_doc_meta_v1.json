    {
      "level": "L3",
      "tableName": "yy_gl_voucher_entry_aux",
      "tableAlias": "分录辅助核算明细",
      "remark": "用友辅助核算明细(NC gl_freevalue / U8 辅助核算):分录 1:N。一条分录按其科目所挂的辅助核算项,每个辅助项一行 {辅助类型 aux_type, 取值 aux_value};支持任意多个辅助项与自定义维度,真实即动态多辅助而非固定列。",
      "fields": [
        {
          "dataType": "BIGINT",
          "nullable": false,
          "dimType": "relation",
          "physicalField": "pk_detail",
          "id": "entry_id",
          "name": "entry_id",
          "caption": {
            "zh_CN": "所属分录ID"
          }
        },
        {
          "dataType": "VARCHAR",
          "fieldLength": 20,
          "nullable": false,
          "dimType": "dimension",
          "refDict": "aux_acc_type",
          "refField": "code",
          "displayField": "name",
          "id": "aux_type",
          "name": "aux_type",
          "caption": {
            "zh_CN": "辅助核算类型(部门/个人/客户/供应商/项目/存货/自定义)"
          }
        },
        {
          "dataType": "VARCHAR",
          "fieldLength": 40,
