{
  "moduleMeta": {
    "metaName": "用友 ERP GL 会计凭证数据字典元数据",
    "metaKind": "DCT",
    "moduleCode": "GL",
    "moduleName": "总账(用友 ERP)",
    "version": 1,
    "designStyle": "separate-dictionary-tables",
    "remark": "用友 ERP(NC/U8) 总账会计凭证所引用的全部基础档案与配置字典:组织账簿(集团/会计主体/账簿)、科目体系(科目表/会计科目/科目类别/余额方向)、辅助核算(辅助核算类型/部门/人员/客户/供应商/往来分类/项目/存货/自定义项)、凭证控制(凭证类别/来源/结算方式/现金流量项目)、币种期间(币种/汇率类型/会计日历/会计期间)、税与银行(税率/银行账户/操作员)。通用列引用 base_dct_meta_v1.json。用友精髓:科目挂多个辅助核算,凭证分录据此录入辅助核算明细。"
  },
  "baseDctMetaRef": {
    "file": "base_dct_meta_v1.json",
