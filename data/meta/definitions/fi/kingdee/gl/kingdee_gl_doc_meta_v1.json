    {
      "level": "L3",
      "tableName": "kd_gl_voucher_entry_item",
      "tableAlias": "分录核算项目明细",
      "remark": "金蝶核算项目明细(K/3 核算项目组合 t_VoucherGroup/各核算项目表,云星空 EAS 可配置弹性域):分录 1:N。一条分录按其科目所挂的核算维度,每个核算项一行 {核算维度 acc_type, 取值 acc_value};支持任意多个核算项与可配置弹性域,真实即动态多核算项而非固定列。",
      "fields": [
        {
          "dataType": "BIGINT",
          "nullable": false,
          "dimType": "relation",
          "physicalField": "FEntryID",
          "id": "entry_id",
          "name": "entry_id",
          "caption": {
            "zh_CN": "所属分录ID"
          }
        },
        {
          "dataType": "VARCHAR",
          "fieldLength": 30,
          "nullable": false,
          "dimType": "dimension",
          "refDict": "acc_dimension",
          "refField": "code",
          "displayField": "name",
          "id": "acc_type",
          "name": "acc_type",
          "caption": {
            "zh_CN": "核算维度(部门/职员/客户/供应商/物料/项目/自定义)"
          }
        },
        {
          "dataType": "VARCHAR",
          "fieldLength": 40,
          "nullable": false,
          "dimType": "dimension",
