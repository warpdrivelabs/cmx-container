    "fieldAliases": {
      "document_date": "voucher_date",
      "document_type_id": "voucher_word_id",
      "document_no": "voucher_no",
      "document_status": "voucher_status"
    },
    "typeDict": "voucher_word",
    "stateField": "document_status"
  },
  "voucherSchema": {
    "remark": "金蝶凭证三层:L1 [kd_gl_voucher_header] → L2 [kd_gl_voucher_entry] → L3 [kd_gl_voucher_entry_item 核算项目明细]。分录借贷金额上卷至凭证头借贷合计;一条分录挂任意多个核算项目;凭证借贷必须平衡。",
    "schema": [
      [
        {
          "id": "kd_gl_voucher_header",
          "kind": "list",
          "level": "L1",
          "levelName": "凭证头"
        }
      ],
      [
        {
          "id": "kd_gl_voucher_entry",
          "kind": "list",
          "level": "L2",
          "levelName": "分录"
        }
      ],
      [
        {
          "id": "kd_gl_voucher_entry_item",
          "kind": "list",
          "level": "L3",
          "levelName": "核算项目明细"
        }
      ]
    ],
    "relations": [
      {
        "parent": "kd_gl_voucher_header",
        "child": "entries",
        "parentKey": "id",
        "childKey": "header_id"
      },
      {
        "parent": "entries",
        "child": "accitems",
        "parentKey": "id",
        "childKey": "entry_id"
      }
    ],
    "aggregations": [
      {
        "from": "kd_gl_voucher_header.entries",
        "to": "kd_gl_voucher_header",
        "field": "debit_amount",
        "toField": "total_debit",
        "agg": "sum",
        "remark": "分录借方上卷到凭证头借方合计"
      },
      {
        "from": "kd_gl_voucher_header.entries",
        "to": "kd_gl_voucher_header",
        "field": "credit_amount",
        "toField": "total_credit",
        "agg": "sum",
        "remark": "分录贷方上卷到凭证头贷方合计"
      }
    ]
  },
