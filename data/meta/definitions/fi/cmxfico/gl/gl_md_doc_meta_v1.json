    "file": "base_doc_meta_v1.json",
    "version": 1,
    "fieldSets": [
      "documentIdentityFields",
      "documentSourceFields",
      "documentLifecycleFields",
      "documentTechnicalFields",
      "documentCommonFields"
    ],
    "remark": "本模块业务单据复用 base_doc_meta_v1.json 中的基础 fieldSet；voucherCommonFieldSet 与 voucherTables.documentFieldSets 均引用该文件。"
  },
  "_comment_part2": "========== 二、会计凭证元数据（三层：头/分录/明细） ==========",
  "voucherCommonFieldSet": "documentTechnicalFields",
  "voucherDocumentMapping": {
    "remark": "总账凭证对基础单据字段的语义映射。物理字段可采用 document_* 通用命名；界面显示时映射为凭证日期/凭证类型/凭证号/凭证状态。",
    "fieldAliases": {
      "document_date": "voucher_date",
      "document_type_id": "voucher_type_id",
      "document_no": "voucher_no",
      "document_status": "voucher_status"
    },
    "typeDict": "voucher_type",
    "stateField": "document_status"
  },
  "voucherSchema": {
    "remark": "凭证主从三层，每层为表数组（可定义多张表）：L1 [voucher_header] → L2 [voucher_entry] → L3 [voucher_detail]。借贷合计由分录上卷至头；分录金额由明细上卷至分录。",
    "schema": [
      [
        {
          "id": "voucher_header",
          "kind": "list",
          "level": "L1",
          "levelName": "凭证头"
        }
      ],
      [
        {
          "id": "voucher_entry",
          "kind": "list",
          "level": "L2",
          "levelName": "分录"
        }
      ],
      [
        {
          "id": "voucher_detail",
          "kind": "list",
          "level": "L3",
          "levelName": "明细"
        }
      ]
    ],
    "relations": [
      {
        "parent": "voucher_header",
        "child": "entries",
        "parentKey": "id",
        "childKey": "header_id"
      },
      {
        "parent": "entries",
        "child": "details",
        "parentKey": "id",
        "childKey": "entry_id"
      }
    ],
    "aggregations": [
      {
        "from": "voucher_header.entries.details",
        "to": "voucher_header.entries",
        "field": "amount",
        "toField": "line_amount",
        "agg": "sum",
        "remark": "明细金额合计到分录"
      },
      {
        "from": "voucher_header.entries",
        "to": "voucher_header",
        "field": "debit_amount",
        "toField": "total_debit",
        "agg": "sum",
        "remark": "分录借方合计到头"
      },
      {
        "from": "voucher_header.entries",
        "to": "voucher_header",
        "field": "credit_amount",
        "toField": "total_credit",
        "agg": "sum",
        "remark": "分录贷方合计到头"
      }
    ]
  },
