  "_comment_part3": "========== 三、凭证状态流转 ==========",
  "voucherStatusFlow": {
    "stateField": "document_status",
    "remark": "凭证生命周期状态机。transitions 定义允许的状态迁移及触发动作；guard 为迁移前置校验规则集。",
    "states": [
      {
        "code": "draft",
        "name": "草稿",
        "editable": true,
        "remark": "可自由编辑/删除"
      },
      {
        "code": "audited",
        "name": "已审核",
        "editable": false,
        "remark": "审核通过，锁定编辑，等待过账"
      },
      {
        "code": "posted",
        "name": "已过账",
        "editable": false,
        "remark": "已记入总账，生成余额，不可逆(只能红冲)"
      },
      {
        "code": "void",
        "name": "作废",
        "editable": false,
        "remark": "作废终态"
      }
    ],
    "transitions": [
      {
        "action": "submit",
        "name": "提交审核",
        "from": "draft",
        "to": "audited",
        "operatorField": "auditor_id",
        "guard": [
          "balanced",
          "period_open",
          "non_empty_entries",
          "leaf_account_only",
          "required_dims"
        ]
      },
      {
        "action": "withdraw",
        "name": "撤销审核",
        "from": "audited",
        "to": "draft",
        "operatorField": "auditor_id",
        "guard": []
      },
      {
        "action": "post",
        "name": "过账",
        "from": "audited",
        "to": "posted",
        "operatorField": "accountant_id",
        "guard": [
          "balanced",
          "period_open"
        ]
      },
      {
        "action": "unpost",
        "name": "反过账",
        "from": "posted",
        "to": "audited",
        "operatorField": "accountant_id",
        "guard": [
          "period_open"
        ]
      },
      {
        "action": "void",
        "name": "作废",
        "from": "draft",
        "to": "void",
        "operatorField": "preparer_id",
        "guard": []
      }
    ]
  },
  "_comment_part4": "========== 四、记账校验规则 ==========",
  "validationRules": {
    "remark": "凭证保存/状态迁移时的校验规则。level=error 阻断，warning 提示。",
    "rules": [
      {
        "code": "balanced",
        "level": "error",
        "scope": "header",
        "name": "借贷平衡",
        "expr": "total_debit == total_credit",
        "message": "借方合计与贷方合计必须相等"
      },
      {
        "code": "non_empty_entries",
        "level": "error",
        "scope": "header",
        "name": "分录非空",
        "expr": "entries.length >= 2",
        "message": "凭证至少应有两条分录"
      },
      {
        "code": "entry_one_side",
        "level": "error",
        "scope": "entry",
        "name": "单边记账",
        "expr": "(debit_amount > 0) XOR (credit_amount > 0)",
        "message": "每条分录借方、贷方只能填一方且大于0"
      },
      {
        "code": "leaf_account_only",
        "level": "error",
        "scope": "entry",
        "name": "末级科目记账",
        "expr": "account.is_leaf == 1",
        "message": "只能使用末级科目记账"
      },
      {
        "code": "period_open",
        "level": "error",
        "scope": "header",
        "name": "期间已开启",
        "expr": "fiscal_period.period_status == 'open'",
        "message": "会计期间已关闭，不能记账"
      },
      {
        "code": "detail_sum_match",
        "level": "error",
        "scope": "entry",
        "name": "明细金额勾稽",
        "expr": "details.sum(amount) == (debit_amount + credit_amount)",
        "message": "分录下明细金额合计应等于该分录金额"
      },
      {
        "code": "required_dims",
        "level": "error",
        "scope": "detail",
        "name": "必填辅助核算",
        "expr": "account.aux_dims 中标记必填的维度在明细上不为空",
        "message": "该科目启用的辅助核算维度为必填"
      },
      {
        "code": "cashflow_required",
        "level": "warning",
        "scope": "detail",
        "name": "现金流量项目",
        "expr": "account.cashflow_related == 1 => cashflow_item_id != null",
        "message": "涉及现金类科目建议填写现金流量项目"
      }
    ]
  },
  "updatedAt": "2026-06-14T13:01:08.168Z"
}