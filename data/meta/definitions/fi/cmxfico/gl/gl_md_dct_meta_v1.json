  "_comment_metadata_controls": "========== 元数据控制规则 ==========",
  "metadataControls": {
    "remark": "ERP 主数据通用控制能力：唯一约束、编码规则、字段控制、外键引用、权限范围、系统预置和有效期校验。具体字典可在自身元数据上覆盖。",
    "validationRules": [
      {
        "code": "effective_range_valid",
        "level": "error",
        "expr": "effective_to == null || effective_from <= effective_to",
        "message": "失效日期必须为空或不早于生效日期"
      },
      {
        "code": "disabled_reason_recommended",
        "level": "warning",
        "expr": "status == 0 => disabled_reason != null",
        "message": "停用字典项建议填写停用原因"
      },
      {
        "code": "org_scope_required",
        "level": "error",
        "expr": "scope_type == 'acct_entity' => acct_entity_id != null",
        "message": "组织级主数据必须填写适用核算主体"
      },
      {
        "code": "system_item_readonly",
        "level": "error",
        "expr": "is_system == 1 => key_fields_readonly",
        "message": "系统预置项不允许修改关键字段或删除"
      }
    ]
  },
  "_comment_ext_dims": "========== 可扩展维度字典（辅助核算自定义维度） ==========",
  "extensibleDimensions": {
    "remark": "除上述固定维度外，支持业务自定义维度字典(如部门/产品线/区域/资金计划等)。每新增一个维度=新增一张独立字典表，并在 gl_ext_dimension 中绑定到凭证明细表预留的扩展维度槽位。",
