  "rules": [
    {
      "id": "trade-sale-goods",
      "anchor": {
        "dimensions": [
          "txType",
          "productType"
        ],
        "match": {
          "txType": "sale",
          "productType": "goods"
        }
      },
      "detail": {
        "fields": [
          {
            "edit": {
              "mode": "select",
              "required": true
            },
            "dimType": "dimension",
            "refDict": "product",
            "id": "product",
            "name": "product",
            "caption": {
              "zh_CN": "产品"
            }
          },
          {
            "source": {
              "dimension": "product",
              "attribute": "spec"
            },
            "edit": {
              "mode": "readonly"
            },
            "dimType": "attribute",
            "id": "spec",
            "name": "spec",
            "caption": {
              "zh_CN": "规格"
            }
          },
          {
            "source": {
              "dimension": "product",
              "attribute": "uom"
            },
            "edit": {
              "mode": "readonly"
            },
            "dimType": "attribute",
            "id": "uom",
            "name": "uom",
            "caption": {
              "zh_CN": "计量单位"
            }
          },
          {
            "edit": {
              "mode": "input"
            },
            "defaultFrom": {
              "dimension": "product",
              "attribute": "price"
            },
            "display": {
              "decimals": 4,
              "thousand": ",",
              "zeroBlank": true
            },
            "dimType": "measure",
            "id": "unitPrice",
            "name": "unitPrice",
            "caption": {
              "zh_CN": "单价"
            }
          },
          {
            "edit": {
              "mode": "input"
            },
            "unitField": "uom",
            "validations": [
              {
                "expr": "quantity > 0",
                "message": "数量须大于 0"
              }
            ],
            "display": {
              "decimals": 2,
              "zeroBlank": true
            },
            "dimType": "measure",
            "id": "quantity",
            "name": "quantity",
            "caption": {
              "zh_CN": "数量"
            }
          },
          {
            "edit": {
              "mode": "computed"
            },
            "formula": "unitPrice * quantity",
            "dependsOn": [
              "unitPrice",
              "quantity"
            ],
            "display": {
              "decimals": 2,
              "thousand": ",",
              "zeroBlank": true,
              "negativeColor": true
            },
            "dimType": "measure",
            "id": "amount",
            "name": "amount",
            "caption": {
              "zh_CN": "金额"
            }
          },
          {
            "edit": {
              "mode": "select"
            },
            "dimType": "dimension",
            "refDict": "currency",
            "id": "currency",
            "name": "currency",
            "caption": {
              "zh_CN": "币种"
            }
          },
          {
            "edit": {
              "mode": "input"
            },
            "display": {
              "decimals": 2,
              "thousand": ",",
              "zeroBlank": true
            },
            "dimType": "measure",
            "id": "currencyValue",
            "name": "currencyValue",
            "caption": {
              "zh_CN": "币值"
            }
          },
          {
            "edit": {
              "mode": "input"
            },
            "defaultFrom": {
              "dimension": "currency",
              "attribute": "todayRate"
            },
            "display": {
              "decimals": 4,
              "zeroBlank": true
            },
            "dimType": "measure",
            "id": "exchangeRate",
            "name": "exchangeRate",
            "caption": {
              "zh_CN": "汇率"
            }
          },
          {
            "edit": {
              "mode": "computed"
            },
            "formula": "currencyValue * exchangeRate",
            "dependsOn": [
              "currencyValue",
              "exchangeRate"
            ],
            "display": {
              "decimals": 2,
              "thousand": ",",
              "zeroBlank": true,
              "negativeColor": true
            },
            "dimType": "measure",
            "id": "baseAmount",
            "name": "baseAmount",
            "caption": {
              "zh_CN": "本位币金额"
            }
          }
        ],
        "groups": [
          {
            "caption": "商品信息",
            "members": [
              "product",
              "spec",
              "uom"
            ]
          },
          {
            "caption": "价量与金额",
            "members": [
              {
                "caption": "单价 / 数量",
                "members": [
                  "unitPrice",
                  "quantity"
                ]
              },
              "amount"
            ]
          },
          {
            "caption": "币种结算",
            "members": [
              "currency",
              {
                "caption": "本位币换算",
                "members": [
                  "currencyValue",
                  "exchangeRate",
                  "baseAmount"
                ]
              }
            ]
          }
        ]
      }
    },
