  "rules": [
    {
      "id": "fi-cash",
      "anchor": {
        "dimensions": [
          "gl_account"
        ],
        "columns": [
          "gl_account_id"
        ],
        "match": {
          "gl_account.account_type": "AC004",
          "gl_account.cashflow_related": "true"
        }
      },
      "panel": "cv_acc_line",
      "caption": "现金",
      "detail": {
        "table": "cv_acc_line",
        "use": "*",
        "fields": []
      }
    },
    {
      "id": "fi-bank",
      "anchor": {
        "dimensions": [
          "gl_account"
        ],
        "columns": [
          "gl_account_id"
        ],
        "match": {}
      },
      "detail": {
        "table": "cv_acc_line",
        "pick": [
          {
            "ref": "cv_aux_line.house_bank_id",
            "over": {
              "caption": {
                "zh_CN": "银行账户"
              },
              "edit": {
                "mode": "select",
                "required": true
              }
            }
          },
          {
            "ref": "cv_acc_line.item_text",
            "over": {
              "caption": {
                "zh_CN": "备注"
              }
            }
          },
          {
            "ref": "cv_acc_line.entered_dr",
            "over": {
              "caption": {
                "zh_CN": "金额"
              },
              "display": {
                "decimalDigits": 2,
                "thousandSeparator": true,
                "negativeColor": true
              }
            }
          }
        ],
        "groups": [
          {
            "caption": "辅助核算",
            "members": [
              "house_bank_id"
            ]
          },
          {
            "caption": "金额信息",
            "members": [
              "item_text",
              "entered_dr"
            ]
          }
        ],
        "fields": []
      },
      "panel": "cv_acc_line",
      "caption": "银行"
    },
