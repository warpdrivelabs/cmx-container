{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build web-server",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--bin=web-server",
                "--package=web-server"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cargo build web-server --release",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build",
                "--release",
                "--bin=web-server",
                "--package=web-server"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build"
        }
    ]
}
