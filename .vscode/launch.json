{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug web-server",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/web-server",
      "args": [],
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "--bin=web-server"
        ]
      },
      "env": {
        "RUST_LOG": "info",
        "RUST_BACKTRACE": "1"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "Debug web-server (with config)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/web-server",
      "args": [],
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "--bin=web-server"
        ]
      },
      "env": {
        "RUST_LOG": "debug",
        "RUST_BACKTRACE": "1",
        "CONFIG_FILE": "config.toml"
      },
      "sourceLanguages": [
        "rust"
      ]
    },
    {
      "name": "Release web-server",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/release/web-server",
      "args": [],
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--bin=web-server"
        ]
      },
      "env": {
        "RUST_LOG": "info",
        "CONFIG_FILE": "config.toml"
      },
      "sourceLanguages": ["rust"]
    }
  ]
}
